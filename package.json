{
  "name": "reachinbox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:worker": "npm run worker:dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write backend/src frontend/src scripts e2e playwright.config.ts",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.0": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true
  }
}
