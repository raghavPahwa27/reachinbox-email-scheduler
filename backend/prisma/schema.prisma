generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  googleId String @unique
  name String
  email String @unique
  avatar String?
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  senders Sender[]
  emails Email[]
  slackIntegration SlackIntegration?
  batches ScheduleBatch[]
}
model Sender {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  email String
  name String
  smtpHost String @default("smtp.ethereal.email")
  smtpPort Int @default(587)
  smtpUser String
  smtpPasswordEncrypted String
  hourlyLimit Int @default(200)
  minDelaySeconds Int @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  emails Email[]
  batches ScheduleBatch[]
  @@unique([id,userId])
  @@unique([userId,email])
}
model ScheduleBatch {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  senderId String @db.Uuid
  idempotencyKey String
  requestHash String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  sender Sender @relation(fields:[senderId,userId],references:[id,userId],onDelete:Restrict)
  emails Email[]
  attachments Attachment[]
  @@unique([userId,idempotencyKey])
  @@unique([id,userId])
}
model Email {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  senderId String @db.Uuid
  batchId String @db.Uuid
  recipient String
  subject String
  body String
  bodyHtml String?
  starred Boolean @default(false)
  archived Boolean @default(false)
  trashedAt DateTime?
  scheduledAt DateTime
  originalScheduledAt DateTime
  sentAt DateTime?
  status EmailStatus @default(SCHEDULED)
  bullJobId String @unique
  idempotencyKey String @unique
  errorMessage String?
  previewUrl String?
  delaySeconds Int
  hourlyLimit Int
  attempts Int @default(0)
  processingAt DateTime?
  indexDirty Boolean @default(true)
  searchVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  sender Sender @relation(fields:[senderId,userId],references:[id,userId],onDelete:Restrict)
  batch ScheduleBatch @relation(fields:[batchId,userId],references:[id,userId],onDelete:Restrict)
  @@index([userId,status,scheduledAt,id])
  @@index([userId,status,sentAt,id])
  @@index([senderId,status,originalScheduledAt])
  @@index([indexDirty,updatedAt])
  @@index([status,updatedAt])
}
model Attachment {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  filename String
  contentType String
  size Int
  content Bytes
  batch ScheduleBatch @relation(fields:[batchId],references:[id],onDelete:Cascade)
  @@index([batchId])
}
model SlackIntegration {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  accessTokenEncrypted String
  teamId String
  teamName String
  channelId String
  connectedAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
}
