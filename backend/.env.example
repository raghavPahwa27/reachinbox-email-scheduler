# Copy this file to backend/.env. Do not commit backend/.env.
# npm workspace scripts run with backend/ as the working directory.
# dotenv/config loads .env from that working directory; existing exported
# environment variables take precedence. Restart API/worker after changes.
# Do not put any of these secrets in frontend VITE_* variables.

# REQUIRED at startup: DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY.
# This DATABASE_URL matches the local Docker Compose development defaults.
DATABASE_URL=postgresql://reachinbox:reachinbox_local@localhost:5432/reachinbox?schema=public
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# At least 32 characters. Used to sign server-side sessions (not browser JWTs).
JWT_SECRET=
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Exactly 32 bytes encoded as base64. Keep stable to decrypt stored credentials.
ENCRYPTION_KEY=

# OPTIONAL overrides; the code defaults to these values when variables are absent.
NODE_ENV=development
# Express default and Vite proxy are both 3001.
# Callback URLs do not automatically change if you override PORT.
PORT=3001
# Exact frontend origin used by CORS and OAuth completion redirects.
# HTTPS required when NODE_ENV=production.
FRONTEND_URL=http://localhost:5173
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional; leave empty for the supplied local Redis Compose service.
REDIS_PASSWORD=
ELASTICSEARCH_URL=http://localhost:9200

# REQUIRED for Google login, but optional for API/worker startup.
# Use OAuth client type Web application. Register the exact callback below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default callback. Update explicitly if changing API host/port.
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# REQUIRED for Slack connect/notifications, but optional for startup.
# Bot scope: chat:write. No incoming-webhook scope is used.
# Enter the notification channel ID in Connect Slack and invite the bot.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Default callback path. Slack may require an HTTPS tunnel for local testing.
# Register the exact public URL with Slack, keeping /api/slack/callback.
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# Optional default SMTP account. Supply BOTH user/pass, or supply each sender's
# credentials in Manage senders. Real Ethereal credentials are needed to send.
ETHEREAL_HOST=smtp.ethereal.email
# Only 587 (STARTTLS) or 465 (TLS) are supported.
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_TIMEOUT_MS=30000

# OPTIONAL worker and sender defaults / system policy.
WORKER_CONCURRENCY=5
MIN_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Must be >= MAX_EMAILS_PER_HOUR_PER_SENDER.
SYSTEM_MAX_EMAILS_PER_HOUR=1000

# OPTIONAL comma-separated Google-account emails allowed to manage all queues.
# Empty means nobody can access /admin/queues.
ADMIN_EMAILS=
